# What the MCP server, manager and launcher read. tandem start / tandem join set these for you;
# set them yourself only when running a piece by hand. Never commit a real .env.
STDB_URI=ws://127.0.0.1:3001   # the brain (SpacetimeDB)
STDB_DB=tandem-local           # the team's database
TANDEM_SESSION=live            # the page only shows "live"
TANDEM_WORKER_ID=              # MCP server: which worker this Claude Code acts as
TANDEM_TOKEN_FILE=             # where this identity's login token is saved
BRAIN_MODE=                    # MCP server: "mock" runs without a brain
LAUNCHER_MODEL=haiku           # launcher: model for every task (unset = by difficulty)
LAUNCHER_BUDGET_USD=0.50       # launcher: cap per Claude run
